{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Pong: compiler (MSVC)",
            "type": "shell",
            "command": "${workspaceFolder}\\.vscode\\build-pong.bat",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "C:\\Windows\\System32\\cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": "$msCompile",
            "group": "build",
            "detail": "Compile main.cpp with MSVC and the local OpenCV world library."
        },
        {
            "label": "Pong: lancer",
            "type": "process",
            "command": "${workspaceFolder}\\Pong.exe",
            "dependsOn": "Pong: compiler (MSVC)",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${workspaceFolder}\\opencv\\build\\x64\\vc16\\bin;${env:PATH}"
                }
            },
            "problemMatcher": [],
            "detail": "Compile Pong with MSVC, then run it with the OpenCV DLL directory on PATH."
        },
        {
            "label": "Pong: compiler et lancer",
            "dependsOn": "Pong: lancer",
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
